# TrailerVegas — Phase 0 environment variables
# Copy these KEYS into Vercel → Settings → Environment Variables.
# Do NOT put real values in this file.
# Real values live only in Vercel.

# --- Supabase: PROJECT 1 (trailervegas-users) ---
# The website ONLY talks to this project.
# From Supabase → Project Settings → API.
SUPABASE_USERS_URL=your-users-project-url
SUPABASE_USERS_ANON_KEY=your-users-project-anon-key
SUPABASE_USERS_SERVICE_ROLE_KEY=your-users-project-service-role-key

# SERVICE_ROLE_KEY is a SERVER-ONLY master key.
# Never expose to the browser. Never commit. Never screenshot.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://trailervegas.com
NEXT_PUBLIC_COVENANT_VERSION=v1.2

# --- Analytics (Plausible). Leave blank to disable. ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=trailervegas.com

# --- NOTE ---
# Supabase PROJECT 2 (trailervegas-roundtable) is the AI coordination
# store. It is NOT used by the website. Its keys do NOT belong in
# Vercel. They live in the automation environment only.
# Keeping them apart is the point — see docs/STACK.md.
